{
  "name": "@landstrip/landstrip-api",
  "version": "0.20.15",
  "description": "TypeScript APIs for the Landstrip sandbox",
  "license": "Apache-2.0",
  "homepage": "https://github.com/landstrip/landstrip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landstrip/landstrip.git"
  },
  "bugs": {
    "url": "https://github.com/landstrip/landstrip/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/shared.d.ts",
      "default": "./lib/shared.js"
    },
    "./proxy": {
      "types": "./lib/proxy.d.ts",
      "default": "./lib/proxy.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@landstrip/landstrip": "0.20.15",
    "ipaddr.js": "^2.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
